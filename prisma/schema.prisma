generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String       @id @default(uuid())
  email           String?      @unique
  googleId        String?      @unique
  username        String?      @unique
  displayName     String?
  avatar          String?      @default("♟")
  skillTier       String?      @default("intermediate")
  elo             Int          @default(800)
  peakElo         Int          @default(800)
  targetElo       Int?         @default(1500)
  streak          Int          @default(0)
  bestStreak      Int          @default(0)
  lastSolvedDate  String?
  streakFreezes   Int          @default(0)
  perfectWeekCounter Int       @default(0)
  isFrozenState   Boolean      @default(false)
  solvedPuzzleIds String[]     @default([])
  savedPuzzleIds  String[]     @default([])
  likedPuzzleIds  String[]     @default([])
  autoAdvance     Boolean      @default(false)
  soundEnabled    Boolean      @default(true)
  showCoordinates Boolean      @default(true)
  isCalibrated    Boolean      @default(false)
  calibrationStep Int          @default(0)
  passwordHash    String?
  plan            String?      @default("free")
  bonusQuota      Int          @default(0)
  isPro               Boolean   @default(false)
  subscriptionStatus  String    @default("none")
  subscriptionPlan    String?
  paymentProvider     String?
  providerSubscriptionId String?
  currentPeriodEnd    DateTime?
  isTestAccount   Boolean?     @default(false)
  createdAt       DateTime     @default(now())

  // Friendships
  friendships            Friendship[]    @relation("UserFriendships")
  friendOf               Friendship[]    @relation("FriendUsers")
  sentFriendRequests     FriendRequest[] @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedFriendRequests")

  @@index([providerSubscriptionId])
}

model Friendship {
  id        String   @id @default(uuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())

  user      User     @relation("UserFriendships", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("FriendUsers", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
}

model FriendRequest {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  status     String   @default("pending") // 'pending' | 'accepted' | 'declined'
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  sender     User     @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Puzzle {
  id              String   @id
  fen             String
  moves           String
  rating          Int
  ratingDeviation Int
  popularity      Int
  nbPlays         Int
  themes          String
  gameUrl         String
  openingTags     String?
  likes           Int      @default(0)

  @@index([rating])
  @@index([themes])
}

model PuzzleHistory {
  id       String   @id @default(uuid())
  userId   String
  puzzleId String
  result   String   // 'win' or 'loss'
  solvedAt DateTime @default(now())

  @@unique([userId, puzzleId])
  @@index([userId])
}

model PuzzleLike {
  id        String   @id @default(uuid())
  puzzleId  String
  userId    String
  createdAt DateTime @default(now())

  @@unique([puzzleId, userId])
  @@index([puzzleId])
}

